project Rogue_Engine is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("tests.adb");

   package Builder is
      for Default_Switches ("Ada") use ("-s");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa", "-gnat2022", "-gnato", "-fstack-check", "-gnata");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
end Rogue_Engine;
